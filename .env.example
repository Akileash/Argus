# ---- Fill these in later. Local dev works with all of them blank. ----
# Hosted Supabase (leave blank to use local `supabase start` values printed in the terminal)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM report worker: fixture | gemini | hybrid   (fixture needs no keys)
REPORT_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Hard stop for LLM spend tracked in the analyses table (USD)
LLM_SPEND_CAP_USD=25
