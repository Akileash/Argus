# ---- Fill these in later. Local dev works with all of them blank. ----
# Hosted Supabase (leave blank to use local `supabase start` values printed in the terminal)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM report worker: fixture | gemini | hybrid   (fixture needs no keys)
REPORT_MODE=fixture
GEMINI_API_KEY=
# Recommended: gemini-3.5-flash (fast and accurate on our clips; gemini-3.8-flash was overloaded and hung).
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Hard stop for LLM spend tracked in the analyses table (USD)
LLM_SPEND_CAP_USD=25

# --- Report worker limits (all optional; the defaults below apply when blank) ---
# A clip smaller than this (media.bytes, and the downloaded file) counts as "no video": sensor-only report.
WORKER_MIN_CLIP_BYTES=50000
# Gemini Files API: how long to wait for an uploaded video to leave PROCESSING, in seconds
GEMINI_PROCESSING_TIMEOUT_S=120
# Time limit for each single provider step (Gemini upload, Gemini generate, Claude request), in seconds
LLM_CALL_TIMEOUT_S=180
# Total times a worker may claim one event (reclaims included); then it is marked failed
WORKER_MAX_ANALYSIS_ATTEMPTS=3
# How often a working worker refreshes events.updated_at, in ms
WORKER_HEARTBEAT_MS=30000
# An event in `analyzing` this long with no heartbeat is re-queued, in ms. Blank = computed from the timeouts
# above (1 560 000 = 26 min with the defaults). Do not set it below one attempt's worst case.
WORKER_STALE_ANALYZING_MS=
