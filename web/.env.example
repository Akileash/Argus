# Copy to .env.local. Local Supabase (`pnpm exec supabase start` at repo root) prints these values
# (`pnpm exec supabase status -o env`). Keys are intentionally blank.
#
# Local defaults:
#   API URL        http://127.0.0.1:54321
#   DB             postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Demo login     demo@argus.local / argus-demo-2026  (seeded manager)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by the device API (service role).
SUPABASE_SERVICE_ROLE_KEY=
